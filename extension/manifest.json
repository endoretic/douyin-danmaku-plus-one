{
  "manifest_version": 3,
  "name": "抖音弹幕 +1",
  "version": "0.1.1",
  "description": "点击视频上的漂浮弹幕，预览后 +1 发送相同内容。支持直播 Canvas 与文字弹幕。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "抖音弹幕 +1",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*", "https://live.douyin.com/*"],
      "js": ["canvas-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.douyin.com/*", "https://live.douyin.com/*"],
      "js": ["site-adapter.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
